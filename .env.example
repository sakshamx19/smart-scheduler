# Smart Scheduler: copy this file to .env and fill in the blanks. Never commit .env.
# On a hosting platform, set the same names as environment variables instead.

# ---- Model
# openai (any OpenAI-compatible endpoint) or anthropic (required)
LLM_PROVIDER=openai
# Your key for the endpoint below (required)
OPENAI_API_KEY=
# Empty for OpenAI itself. Azure: https://<resource>.openai.azure.com/openai/v1/
OPENAI_BASE_URL=
# The model, or on Azure the deployment name (required)
OPENAI_MODEL=
# Reasoning models only: none or low answer fastest, which matters for voice
OPENAI_REASONING_EFFORT=
# Optional. Some reasoning models accept only their default; leave it empty for those
LLM_TEMPERATURE=
# Your Anthropic key
# ANTHROPIC_API_KEY=
# e.g. claude-opus-5-5 or claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Tools
# The JSON key of saksham-kumar@tryingbard-388910.iam.gserviceaccount.com, on one line (or use the file below) (required)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or: a path to the key file, e.g. service-account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=
# Shared with the service account (Make changes to events) (required)
GOOGLE_CALENDAR_ID=
# IANA name; the calendar's own time zone
CALENDAR_TIMEZONE=Asia/Kolkata
# Start of working hours, used unless the user asks for other times
WORK_START=09:00
# End of working hours
WORK_END=18:00
# Working days, separated by commas
WORK_DAYS=monday,tuesday,wednesday,thursday,friday

# ---- Server
# Conversations are kept here (SQLite); empty keeps them in memory
CHECKPOINT_DB=data/agent.db
# Set it to keep strangers off a public deployment; the portal asks for it once
ACCESS_CODE=

# ---- Voice
# device (Whisper in the browser, as in KIRA: private, about 77 MB once) | browser (Chrome and Edge, fastest) | openai | deepgram
STT_PROVIDER=device
# device (Supertonic in the browser, as in KIRA: natural voice, about 262 MB once) | browser (instant) | openai | elevenlabs
TTS_PROVIDER=device
# BCP 47 language for speech, e.g. en-US, en-IN, hi-IN
VOICE_LANGUAGE=en-US
# Optional: part of a browser voice's name to prefer, e.g. Aria or Google
BROWSER_VOICE=
